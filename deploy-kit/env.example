# 大肥鱼部署配置与密钥备忘单：复制成 .env 再填真实值
#   bash:       cp deploy-kit/env.example .env
#   PowerShell: Copy-Item deploy-kit\env.example .env
#   体检核对:   python deploy-kit/preflight.py --env .env
#
# ⚠️ .env 不要提交到 Git（.gitignore 已排除）
#
# 说明：
#   - AstrBot 本身的模型与平台配置在 Web 面板（http://localhost:6185）或 data/cmd_config.json 里填；
#   - 这份 .env 一方面给你集中备忘、让 preflight.py 帮你核对有没有漏填，
#     另一方面 face_convert 插件会直接读取环境变量 DASHSCOPE_API_KEY（也可以写在插件目录的 config.json -> asr_api_key）。

# ---- 必填密钥 ----
# DeepSeek：对话主力  https://platform.deepseek.com
DEEPSEEK_API_KEY=<sk-你的DeepSeek密钥>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 阿里云百炼（DashScope）：看图 / 语音听写 / 语音条 TTS
# 地址：https://bailian.console.aliyun.com → API-KEY 管理
# 注：把此环境变量传给 AstrBot 进程，或写进 plugin/astrbot_plugin_face_convert/config.json 的 "asr_api_key"，
#     这样将来把 TTS 换成别的方案，也不会连带把语音识别和视频理解弄哑。
DASHSCOPE_API_KEY=<sk-你的百炼密钥>

# ---- 机器人与主人账号 ----
# 用来跑机器人的 QQ 小号（强烈建议用小号，不要和主人大号相同）
QQ_ACCOUNT=<机器人小号QQ号>
# 你自己的 QQ（主人/管理员，填进 AstrBot 的 admins_id，群聊和私聊都会被识别为「主人」）
OWNER_QQ=<你自己的QQ号>

# ---- 模型选择（照填到 AstrBot 面板「服务提供商」，一般不用改）----
CHAT_MODEL=deepseek-chat
VISION_MODEL=qwen3-vl-plus
ASR_MODEL=qwen3-asr-flash
TTS_MODEL=qwen-audio-3.1-tts-flash
# 百炼音色复刻拿到的 voice_id（不填就用默认音色；复刻教程见 docs/导入指南.md）
TTS_VOICE_ID=

# ---- 长期记忆嵌入（二选一）----
# 方案 A（本地免费）：ollama pull bge-m3
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 方案 B（云端免本地模型）：硅基流动 Pro/BAAI/bge-m3（与本地 bge-m3 向量兼容）
SILICONFLOW_API_KEY=

# ---- 服务地址（默认本机）----
ASTRBOT_URL=http://127.0.0.1:6185
ONEBOT_WS_URL=ws://127.0.0.1:6199/ws
NAPCAT_WEBUI=http://127.0.0.1:6099
