# 大肥鱼 · macOS 本机部署配置
# 首次运行 ./start.sh 会自动把它复制成 .env（.env 已被 git 忽略）。
# 改完不需要重建镜像，./start.sh --no-build 或 docker compose up -d 生效。

# 容器时区（日志与容器时间；业务日界线在插件里固定按 Asia/Shanghai 算）
TZ=Asia/Shanghai

# 面板 / WebUI 端口，都只绑 127.0.0.1。被占用时改成 6186 / 6100 之类。
ASTRBOT_PORT=6185
NAPCAT_PORT=6099

# QQ 小号（强烈建议小号）。首次部署仍要扫码（快速登录需要已有登录态）；
# 扫码成功过一次后，后续重启会尝试用这个号快速登录，免扫码。
# 留空则每次都要扫码。填错不影响：WebUI 里还能重新扫。
QQ_ACCOUNT=

# NapCat WebUI 登录 token（可选）。留空则由 NapCat 首次启动随机生成，
# 之后从 napcat/config/webui.json 的 token 字段读取；
# 填了就用这个固定值（镜像入口只在 webui.json 不存在时写入）。
WEBUI_TOKEN=

# 让容器里的 napcat 用户对齐宿主 uid/gid，避免挂载目录归属混乱。
# 一般不用改：start.sh 会按 `id -u` / `id -g` 自动导出实际值。
# NAPCAT_UID=501
# NAPCAT_GID=20
